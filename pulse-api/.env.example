# Copy to .env and fill in. All vars are prefixed PULSE_.

PULSE_DATABASE_URL=postgresql+asyncpg://pulse:pulse@localhost:5432/pulse
PULSE_DEBUG=true

# Generate with: openssl rand -hex 32
PULSE_JWT_SECRET=change-me

# Google Cloud console → OAuth 2.0 client (Web application).
# Scopes needed: openid, email, profile, gmail.readonly, gmail.modify
PULSE_GOOGLE_CLIENT_ID=
PULSE_GOOGLE_CLIENT_SECRET=
PULSE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Gemini classifier — free-tier key from https://aistudio.google.com/apikey
# (no billing needed). Classification is skipped until this is set.
PULSE_GEMINI_API_KEY=
# PULSE_GEMINI_MODEL=gemini-2.5-flash-lite

# Background Gmail sync (in-process loop). Set false to disable.
# PULSE_SYNC_ENABLED=true
# PULSE_SYNC_INTERVAL_MINUTES=10
# PULSE_GMAIL_LOOKBACK_DAYS=7
