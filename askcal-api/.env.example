# Copy to .env and fill in. All vars are prefixed ASKCAL_.

ASKCAL_DATABASE_URL=postgresql+asyncpg://askcal:askcal@localhost:5432/askcal
ASKCAL_DEBUG=true

# Generate with: openssl rand -hex 32
ASKCAL_JWT_SECRET=change-me

# Google Cloud console → OAuth 2.0 client (Web application).
# Scopes needed: openid, email, profile, gmail.readonly, gmail.modify,
# calendar.readonly (one consent flow covers mail + calendar).
ASKCAL_GOOGLE_CLIENT_ID=
ASKCAL_GOOGLE_CLIENT_SECRET=
ASKCAL_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Where this API is publicly reachable — builds the mobile OAuth callback
# ({api_base_url}/auth/google/callback must also be added to the Google
# console client). Required for the iOS app's Connect flow to work on a
# physical device; a tunnel (ngrok, etc.) works for local development.
ASKCAL_API_BASE_URL=http://localhost:8000

# Classifier transport: claude_code (default) or gemini.
#
# claude_code needs no API key — it drives the locally-installed `claude` CLI
# against your own Claude subscription. Install it and sign in:
#   npm i -g @anthropic-ai/claude-code && claude
# That's the whole setup; nothing below is required.
# ASKCAL_LLM_PROVIDER=claude_code
# ASKCAL_CLAUDE_CODE_MODEL=sonnet      # or haiku, for less quota per sync
# ASKCAL_CLAUDE_CODE_EFFORT=low        # classification follows a rubric; low is enough
# ASKCAL_CLAUDE_CODE_BATCH_SIZE=25
# Only needed in Docker, where there is no home dir holding CLI credentials.
# Mint on the host with `claude setup-token`.
# ASKCAL_CLAUDE_CODE_OAUTH_TOKEN=

# Gemini alternative — free-tier key from https://aistudio.google.com/apikey
# (no billing needed). Set ASKCAL_LLM_PROVIDER=gemini to use it.
ASKCAL_GEMINI_API_KEY=
# ASKCAL_GEMINI_MODEL=gemini-2.5-flash-lite

# Background Gmail sync (in-process loop). Set false to disable.
# ASKCAL_SYNC_ENABLED=true
# ASKCAL_SYNC_INTERVAL_MINUTES=10
# ASKCAL_GMAIL_LOOKBACK_DAYS=7
