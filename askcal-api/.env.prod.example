# Copy to .env.prod ON THE VM and fill in. Never commit .env.prod.
# All app vars are prefixed ASKCAL_. POSTGRES_PASSWORD (no prefix) is consumed
# by docker-compose.prod.yml for the Postgres container itself.

# Strong random password shared by the db container and the API's DB URL below.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# API connects to the db service over the internal compose network (host "db").
# The password here MUST match POSTGRES_PASSWORD above.
ASKCAL_DATABASE_URL=postgresql+asyncpg://askcal:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/askcal

ASKCAL_DEBUG=false

# Generate with: openssl rand -hex 32
ASKCAL_JWT_SECRET=

# Google Cloud console → OAuth 2.0 client (Web application).
ASKCAL_GOOGLE_CLIENT_ID=
ASKCAL_GOOGLE_CLIENT_SECRET=
ASKCAL_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Public HTTPS base URL of this deployment. The mobile OAuth callback
# ({api_base_url}/auth/google/callback) must also be registered in the
# Google console client.
ASKCAL_API_BASE_URL=https://api.askcal.lucenity.dev

# Classifier transport: claude_code (default) or gemini.
#
# claude_code drives the `claude` CLI baked into the image against your own
# Claude subscription — no API key, no per-call billing. Inside a container
# there is no home directory holding CLI credentials, so the OAuth token is
# MANDATORY here: mint it on your own machine with `claude setup-token` and
# paste it below. A token rather than a mounted ~/.claude on purpose — it is a
# copy, and it is revocable.
ASKCAL_LLM_PROVIDER=claude_code
ASKCAL_CLAUDE_CODE_OAUTH_TOKEN=
# ASKCAL_CLAUDE_CODE_MODEL=sonnet     # or haiku, for less quota per sync
# ASKCAL_CLAUDE_CODE_EFFORT=low
# ASKCAL_CLAUDE_CODE_BATCH_SIZE=25
# ASKCAL_CLAUDE_CODE_TIMEOUT_SECONDS=240

# Gemini alternative — set ASKCAL_LLM_PROVIDER=gemini, then pick ONE backend:
#  A) AI Studio: set the key from https://aistudio.google.com/apikey (its own billing).
#  B) Vertex AI (recommended on GCP): leave the key blank, set the three vars
#     below. Auth uses the VM's service account (needs roles/aiplatform.user +
#     cloud-platform scope); billed to the GCP project, so it draws on Cloud
#     credits instead of a separate AI Studio balance.
ASKCAL_GEMINI_API_KEY=
ASKCAL_GEMINI_USE_VERTEX=false
ASKCAL_GEMINI_VERTEX_PROJECT=
ASKCAL_GEMINI_VERTEX_LOCATION=us-central1
# Model: gemini-2.5-flash-lite (cheapest, free-tier friendly) or
# gemini-2.5-flash (stronger reasoning, better classification, still cheap).
ASKCAL_GEMINI_MODEL=gemini-2.5-flash-lite

# Background Gmail sync (in-process loop).
ASKCAL_SYNC_ENABLED=true
ASKCAL_SYNC_INTERVAL_MINUTES=10

# Comma-separated. Defaults cover the deployed web origin and local dev.
# ASKCAL_CORS_ORIGINS=["https://askcal.lucenity.dev"]

# Classifier pacing. Leave unset to get the active provider's own economics
# (Gemini: small batches paced for free-tier RPM; Claude Code: one larger call).
# ASKCAL_CLASSIFY_BATCH_SIZE=
# ASKCAL_CLASSIFY_DELAY_SECONDS=
